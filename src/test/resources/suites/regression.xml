<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<!-- CI gate: everything in "regression", never the known-defect contract tests (O7, O8) -->
<suite name="api-regression" parallel="classes" thread-count="4">
    <test name="regression">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="known-defect"/>
                <exclude name="quarantine"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.alhusseinzaghloul.restfulbooker.tests.*"/>
        </packages>
    </test>
</suite>
