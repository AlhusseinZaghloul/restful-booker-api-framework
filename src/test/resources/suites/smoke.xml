<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<!-- Fast health check of the core paths (O8) -->
<suite name="api-smoke" parallel="classes" thread-count="4">
    <test name="smoke">
        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="known-defect"/>
                <exclude name="quarantine"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.alhusseinzaghloul.restfulbooker.tests.*"/>
        </packages>
    </test>
</suite>
